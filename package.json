{
  "name": "easyread-desktop",
  "version": "1.3.1-tw.4",
  "description": "EasyRead desktop application powered by Electron",
  "author": "Edwardxlai",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "build:backend": "python3 scripts/build_backend.py || python scripts/build_backend.py",
    "build:native": "python3 scripts/build_native.py || python scripts/build_native.py",
    "dist": "npm run build:backend && npm run build:native && electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "publish": [
      {
        "provider": "github",
        "owner": "minix6333",
        "repo": "easyread"
      }
    ],
    "appId": "com.edwardxlai.easyread",
    "productName": "EasyRead",
    "protocols": [
      {
        "name": "EasyRead",
        "schemes": [
          "easyread"
        ]
      }
    ],
    "asar": true,
    "directories": {
      "output": "dist/electron"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "icon": "electron/assets",
    "extraResources": [
      {
        "from": "build/backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/native",
        "to": "native",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "electron/assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "EasyRead-Setup-${version}.exe"
    },
    "mac": {
      "icon": "electron/assets/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "publications",
      "identity": "-",
      "hardenedRuntime": false
    },
    "linux": {
      "icon": "electron/assets/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Office"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
